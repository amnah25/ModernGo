{
	"info": {
		"_postman_id": "moderngo-api-collection",
		"name": "ModernGo API",
		"description": "Full API collection for the ModernGo backend.\n\n**Setup:**\n1. Set the `baseUrl` variable (default: http://localhost:3000)\n2. Register a Store and a Customer — tokens are saved automatically\n3. Use the saved `storeToken` / `customerToken` variables in protected routes\n\n**Auth:** Protected routes use `Bearer {{storeToken}}` or `Bearer {{customerToken}}` automatically via the Authorization header.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
