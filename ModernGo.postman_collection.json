		{
			"name": "Product",
			"item": [
				{
					"name": "Create Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data._id) {",
									"    pm.collectionVariables.set('productId', res.data._id);",
									"}",
									"if (res.data && res.data.product && res.data.product._id) {",
